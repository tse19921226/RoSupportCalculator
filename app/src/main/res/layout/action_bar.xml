<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View"/>

        <import type="android.view.Gravity"/>

        <variable
            name="viewModel"
            type="com.elvis_c.rosupportcalculator.BaseViewModel" />

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_bg"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/action_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/icon_back"
            android:padding="@dimen/dp_20"
            android:onClick="@{()->viewModel.onBackClick()}"
            android:visibility="@{viewModel.showBack? View.VISIBLE:View.GONE}"/>

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/logo"
            android:layout_centerInParent="true"/>

        <ImageView
            android:id="@+id/action_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/icon_home"
            android:padding="@dimen/dp_20"
            android:layout_alignParentEnd="true"
            android:onClick="@{()->viewModel.onHomeClick()}"
            android:visibility="@{viewModel.showHome? View.VISIBLE:View.GONE}"/>

        <ImageView
            android:id="@+id/action_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@android:drawable/ic_menu_sort_by_size"
            android:padding="@dimen/dp_20"
            android:layout_alignParentEnd="true"
            android:onClick="@{()->viewModel.onMenuClick()}"
            android:visibility="@{viewModel.showMenu? View.VISIBLE:View.GONE}"/>

    </RelativeLayout>

</layout>


